# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (used by both the backend and docker-compose) ---
POSTGRES_USER=infora
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=infora_digital_shield
DATABASE_URL=postgresql+psycopg://infora:change_me_dev_only@db:5432/infora_digital_shield

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:5174", "http://localhost:5173"]

# --- Trusted Reverse Proxies ---
# Comma-separated or JSON list of trusted proxy IPs/CIDRs (e.g. ["127.0.0.1","10.0.1.0/24"]).
# In production behind a reverse proxy/load balancer, set this to ONLY your proxy IPs/CIDRs.
TRUSTED_PROXIES=["127.0.0.1", "::1", "localhost"]

# --- Optional third-party providers ---
# Leave blank to run with those features in their honest "not configured" state.
HIBP_API_KEY=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=not-configured

# --- OAuth token encryption key (Fernet-compatible, 32-byte urlsafe base64) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Supports comma-separated keys for rotation ("<new_primary_key>,<old_key>").
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth / OpenID Connect (optional; required only when Google linking is enabled) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/oauth/google/callback

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8001/api/v1
